{
  "name": "dsh-tool-deny",
  "version": "0.6.2",
  "description": "Manage global, workspace and per-preset tool visibility in DeepSeek Harness, with an integrated Web Settings page.",
  "meta": {
    "title": { "en": "Tool policies", "zh": "工具策略" },
    "description": {
      "en": "Hide tools or apply ordered allow-lists globally, per workspace, and per Agent preset.",
      "zh": "按全局、工作区和 Agent 预设隐藏工具并应用分层白名单。"
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./typert": "./typert.host.js",
    "./remote": "./typert.remote-client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0-rc.2 <0.3.0-0"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "js-yaml": "^4.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2"
  },
  "files": [
    "index.js",
    "tool-catalog.js",
    "typert.host.js",
    "typert.remote-client.js",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "tools",
    "agent-preset"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhuangpanda/dsh-tool-deny.git"
  },
  "bugs": "https://github.com/hhuangpanda/dsh-tool-deny/issues",
  "homepage": "https://github.com/hhuangpanda/dsh-tool-deny#readme",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-api-remotes"
      ]
    },
    "engines": {
      "dsh": ">=0.2.0-rc.2 <0.3.0-0"
    }
  }
}
